[0.510, "o", "bright-sdk-downloader — BrightSDK download CLI (Rust)\r\n"]
[0.092, "o", "\r\n"]
[0.087, "o", "Commands:\r\n"]
[0.091, "o", "  resolve    Resolve version + download URL (JSON)\r\n"]
[0.093, "o", "  fetch      Download and extract SDK archive\r\n"]
[0.091, "o", "  platforms  List available platform keys\r\n"]
[0.092, "o", "\r\n"]
[0.093, "o", "Options:\r\n"]
[0.090, "o", "  -p, --platform   Platform key (android, ios, tizen...)\r\n"]
[0.089, "o", "  -v, --version    Version or \"latest\" (default: latest)\r\n"]
[0.094, "o", "  -o, --output     Output directory (default: .)\r\n"]
[0.092, "o", "\r\n"]
[0.088, "o", "Environment:\r\n"]
[0.093, "o", "  SDK_API_KEY      Required. BrightSDK API key.\r\n"]
[0.090, "o", "\r\n"]
[0.093, "o", "Examples:\r\n"]
[0.091, "o", "  bright-sdk-downloader resolve -p android\r\n"]
[0.090, "o", "  bright-sdk-downloader fetch -p ios -o ./libs\r\n"]
[0.088, "o", "  bright-sdk-downloader platforms\r\n"]
